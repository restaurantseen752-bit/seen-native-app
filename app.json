{
  "expo": {
    "name": "مطعم سين",
    "slug": "seen-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon_padded.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon_padded.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.seen.restaurant"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./splash_padded.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ]
  }
}
