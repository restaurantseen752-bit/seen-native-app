{
  "expo": {
    "name": "مطعم سين",
    "slug": "seen-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.seen.restaurant"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ]
  }
}